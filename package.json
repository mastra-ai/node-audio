{
  "name": "@mastra/node-audio",
  "version": "0.1.6",
  "description": "Cross-platform mic/audio recording + playback for Mastra in Node.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "example": "npx bun run src/examples/main.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@bropat/fluent-ffmpeg": "^2.1.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@mastra/node-speaker": "^0.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "fluent-ffmpeg-multistream": "^1.0.0",
    "node-mic": "^1.0.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^24.7.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
